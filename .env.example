# TrustGrid Ethiopia — Environment Variables
# Copy this file to .env and fill in your real credentials.
# NEVER commit .env to git.

# Supabase — Get these from: https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Google Gemini AI — Get this from: https://aistudio.google.com/apikey
VITE_GEMINI_API_KEY=your-gemini-api-key-here

# Telegram Login
VITE_TELEGRAM_BOT_USERNAME=your-telegram-bot-username-here
